PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string for production; local MongoDB for development.
MONGODB_URI=mongodb://localhost:27017/weather_db
MONGODB_TEST_URI=mongodb://localhost:27017/weather_test_db

# Generate a long, random value before deploying.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Initial admin account; use a strong unique password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-before-deploy

# Comma-separated allowed frontend origins; use the Netlify site URL in production.
FRONTEND_URL=http://localhost:3000
